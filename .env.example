# MongoDB Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Configuration (Opencode Go / Deepseek - matches Vercel DEEPSEEK_API_KEY & DEEPSEEK_BASE_URL)
DEEPSEEK_API_KEY=your-deepseek-or-opencode-api-key
DEEPSEEK_BASE_URL=https://api.opencodego.com/v1

# Application Configuration
NODE_ENV=production
PORT=5001

# Frontend URL (update with your Vercel URL)
VITE_APP_URL=https://your-portfolio.vercel.app

# API URL (optional, defaults to relative /api in production and Vite dev proxy in development)
VITE_API_URL=/api
# Environment-specific overrides (only set if hosting frontend & API on separate domains)
# VITE_API_URL_DEV=/api
# VITE_API_URL_PREVIEW=https://your-preview-url.vercel.app/api
# VITE_API_URL_PROD=https://your-portfolio.vercel.app/api

# Frontend App URL (optional)
# VITE_APP_URL=https://your-portfolio.vercel.app
# VITE_APP_URL_DEV=http://localhost:5173
# VITE_APP_URL_PREVIEW=https://your-preview-url.vercel.app
# VITE_APP_URL_PROD=https://your-portfolio.vercel.app

# Frontend environment hint (optional: preview; leave unset for automatic Vite detection)
# VITE_APP_ENV=production
